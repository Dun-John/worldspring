{
  "name": "worldspring",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "wasm:quick": "node scripts/build-wasm.mjs --quick",
    "dev": "npm --prefix app run dev",
    "build": "npm run wasm && npm --prefix app run build",
    "det": "node scripts/det-wasm.mjs",
    "bench": "node scripts/bench.mjs",
    "check": "npm --prefix app run check",
    "mapd": "cargo run --release -p mapd --",
    "publish": "node scripts/publish.mjs"
  }
}
